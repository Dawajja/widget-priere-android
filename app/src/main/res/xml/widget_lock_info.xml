<?xml version="1.0" encoding="utf-8"?>
<!-- Accepté sur l'écran verrouillé (keyguard) : Good Lock / LockStar sur Samsung, Android 16 sur Pixel -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_lock"
    android:initialLayout="@layout/widget_lock"
    android:initialKeyguardLayout="@layout/widget_lock"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:minResizeWidth="180dp"
    android:minResizeHeight="50dp"
    android:resizeMode="horizontal|vertical"
    android:previewLayout="@layout/widget_preview_lock"
    android:previewImage="@drawable/preview_lock"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
